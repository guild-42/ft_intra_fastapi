# backend のローカル開発用 env テンプレ。
# cp env.example .env して値を埋める(.env は git 禁止)。
# Coolify では同じ key を Environment Variables に設定する。

# --- 42 API ---
FT_API_CLIENT_ID=u-xxxx
FT_API_CLIENT_SECRET=s-xxxx

# --- Firestore / FCM の Service Account 鍵(JSON 全文を1行で)---
# Firebase Console → プロジェクト設定 → サービスアカウント → 新しい秘密鍵を生成 で取得した
# JSON をそのまま貼る。entrypoint.sh が /tmp/sa.json に書き出して使う。
# ローカルで素の uvicorn で動かす時は、代わりに GOOGLE_APPLICATION_CREDENTIALS にファイルパスを指定してもよい。
GOOGLE_CREDENTIALS_JSON=

# --- poller(任意。省略可)---
POLL_INTERVAL_SECONDS=300
REVIEW_POLL_INTERVAL_SECONDS=300
FRIEND_POLL_INTERVAL_SECONDS=120
CHECKOUT_SWEEP_INTERVAL_SECONDS=600
FRIEND_POLLER_CAMPUS_IDS=26
CHECKIN_TTL_SECONDS=10800
